  * @param ensAddr The address of the ENS registry.\n     * @param node The node that this registrar administers.\n     */\n    constructor(ENS ensAddr, bytes32 node) public {\n        ens = ensAddr;\n        rootNode = node;\n    }\n\n    /**\n     * Register a name, or change the owner of an existing registration.\n     * @param label The hash of the label to register.\n     * @param owner The address of the new owner.\n     */\n    function register(bytes32 label, address owner) public only_owner(label) {\n        ens.setSubnodeOwner(rootNode, label, owner);\n    }\n}\n","sourcePath":"/home/user/Dropbox/projects/ens/contracts/FIFSRegistrar.sol","ast":{"absolutePath":"/home/user/Dropbox/projects/ens/contracts/FIFSRegistrar.sol","exportedSymbols":{"FIFSRegistrar":[643]},"id":644,"nodeType":"SourceUnit","nodes":[{"id":570,"literals":["solidity","^","0.5",".0"],"nodeType":"PragmaDirective","src":"0:23:4"},{"absolutePath":"/home/user/Dropbox/projects/ens/contracts/ENS.sol","file":"./ENS.sol","id":571,"nodeType":"ImportDirective","scope":644,"sourceUnit":380,"src":"25:19:4","symbolAliases":[],"unitAlias":""},{"baseContracts":[],"contractDependencies":[],"contractKind":"contract","documentation":"A registrar that allocates subdomains to the first person to claim them.","fullyImplemented":true,"id":643,"linearizedBaseContracts":[643],"name":"FIFSRegistrar","nodeType":"ContractDefinition","nodes":[{"constant":false,"id":573,"name":"ens","nodeType":"VariableDeclaration","scope":643,"src":"159:7:4","stateVariable":true,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_contract$_ENS_$379","typeString":"contract ENS"},"typeName":{"contractScope":null,"id":572,"name":"ENS","nodeType":"UserDefinedTypeName","referencedDeclaration":379,"src":"159:3:4","typeDescriptions":{"typeIdentifier":"t_contract$_ENS_$379","typeString":"contract ENS"}},"value":null,"visibility":"internal"},{"constant":false,"id":575,"name":"rootNode","nodeType":"VariableDeclaration","scope":