,"source":"pragma solidity ^0.5.0;\n\nimport \"openzeppelin-solidity/contracts/ownership/Ownable.sol\";\nimport \"./profiles/ABIResolver.sol\";\nimport \"./profiles/AddrResolver.sol\";\nimport \"./profiles/ContentHashResolver.sol\";\nimport \"./profiles/InterfaceResolver.sol\";\nimport \"./profiles/NameResolver.sol\";\nimport \"./profiles/PubkeyResolver.sol\";\nimport \"./profiles/TextResolver.sol\";\n\n/**\n * A simple resolver anyone can use; only allows the owner of a node to set its\n * address.\n */\ncontract OwnedResolver is Ownable, ABIResolver, AddrResolver, ContentHashResolver, InterfaceResolver, NameResolver, PubkeyResolver, TextResolver {\n    function isAuthorised(bytes32 node) internal view returns(bool) {\n        return msg.sender == owner();\n    }\n}\n","sourcePath":"/Users/deaneigenmann/Documents/resolvers/contracts/OwnedResolver.sol","ast":{"absolutePath":"/Users/deaneigenmann/Documents/resolvers/contracts/OwnedResolver.sol","exportedSymbols":{"OwnedResolver":[556]},"id":557,"nodeType":"SourceUnit","nodes":[{"id":517,"literals":["solidity","^","0.5",".0"],"nodeType":"PragmaDirective","src":"0:23:4"},{"absolutePath":"openzeppelin-solidity/contracts/ownership/Ownable.sol","file":"openzeppelin-solidity/contracts/ownership/Ownable.sol","id":518,"nodeType":"ImportDirective","scope":557,"sourceUnit":4291,"src":"25:63:4","symbolAliases":[],"unitAlias":""},{"absolutePath":"/Users/deaneigenmann/Documents/resolvers/contracts/profiles/ABIResolver.sol","file":"./profiles/ABIResolver.sol","id":519,"nodeType":"ImportDirective","scope":557,"sourceUnit":1060,"src":"89:36:4","symbolAliases":[],"unitAlias":""},{"absolutePath":"/Users/deaneigenmann/Documents/resolvers/contracts/profiles/AddrResolver.sol","file":"./profiles/AddrResolver.sol","id":520,"nodeType":"ImportDirective","scope":557,"sourceUnit":1130,"src":"126:37:4","symbolAliases":[],"unitAlias":""},{"absolutePath":"/Users/deaneigenmann/Documents/resolvers/contracts/profiles/ContentHashResolver.sol","file":