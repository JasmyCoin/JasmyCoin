Date) external;\n    function entries(bytes32 _hash) external view returns (Mode, address, uint, uint, uint);\n}\n","sourcePath":"/home/user/Dropbox/projects/ens/contracts/Registrar.sol","ast":{"absolutePath":"/home/user/Dropbox/projects/ens/contracts/Registrar.sol","exportedSymbols":{"Registrar":[2340]},"id":2341,"nodeType":"SourceUnit","nodes":[{"id":2177,"literals":["solidity",">=","0.4",".24"],"nodeType":"PragmaDirective","src":"0:25:7"},{"absolutePath":"/home/user/Dropbox/projects/ens/contracts/Deed.sol","file":"./Deed.sol","id":2178,"nodeType":"ImportDirective","scope":2341,"sourceUnit":48,"src":"27:20:7","symbolAliases":[],"unitAlias":""},{"baseContracts":[],"contractDependencies":[],"contractKind":"interface","documentation":null,"fullyImplemented":false,"id":2340,"linearizedBaseContracts":[2340],"name":"Registrar","nodeType":"ContractDefinition","nodes":[{"canonicalName":"Registrar.Mode","id":2185,"members":[{"id":2179,"name":"Open","nodeType":"EnumValue","src":"88:4:7"},{"id":2180,"name":"Auction","nodeType":"EnumValue","src":"94:7:7"},{"id":2181,"name":"Owned","nodeType":"EnumValue","src":"103:5:7"},{"id":2182,"name":"Forbidden","nodeType":"EnumValue","src":"110:9:7"},{"id":2183,"name":"Reveal","nodeType":"EnumValue","src":"121:6:7"},{"id":2184,"name":"NotYetAvailable","nodeType":"EnumValue","src":"129:15:7"}],"name":"Mode","nodeType":"EnumDefinition","src":"76:70:7"},{"anonymous":false,"documentation":null,"id":2191,"name":"AuctionStarted","nodeType":"EventDefinition","parameters":{"id":2190,"nodeType":"ParameterList","parameters":[{"constant":false,"id":2187,"indexed":true,"name":"hash","nodeType":"VariableDeclaration","scope":2191,"src":"173:20:7","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":2186,"name":"bytes32","nodeType":"ElementaryTypeName","src":"173:7:7","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"value":null,"visibility":